# LLM Backend: "vllm" (optimized) or "ollama" (legacy)
LLM_BACKEND=vllm

# vLLM Settings (for RTX 3060/4060 8-12GB VRAM)
VLLM_MODEL=Qwen/Qwen3-4B-Instruct
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_GPU_MEMORY_UTILIZATION=0.85
VLLM_MAX_MODEL_LEN=8192
VLLM_DTYPE=half
VLLM_QUANTIZATION=awq
VLLM_ENFORCE_EAGER=false
VLLM_ENABLE_PREFIX_CACHING=true
VLLM_MAX_NUM_BATCHED_TOKENS=4096

# Legacy Ollama Settings (when LLM_BACKEND=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Embeddings (optimized with ONNX)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_USE_ONNX=true
EMBEDDING_BATCH_SIZE=32

# RAG chunking and retrieval (optimized for larger chunks, fewer calls)
CHUNK_SIZE=1500
CHUNK_OVERLAP=200
RETRIEVAL_K=4
MAX_CONTEXT_TOKENS=4000

# Context-window guard for summarization and prompts
CONTEXT_WINDOW_TOKENS=8192
RESERVED_RESPONSE_TOKENS=2048

# Web search: duckduckgo (no key) or tavily
SEARCH_PROVIDER=duckduckgo
SEARCH_MAX_RESULTS=5
TAVILY_API_KEY=

# Generation
LLM_TEMPERATURE=0.1